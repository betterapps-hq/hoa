{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "trailingComma": "none",
  "proseWrap": "always",
  "sortImports": {
    "enabled": true,
    "newlinesBetween": false,
    "sortSpecifiers": true
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/coverage/**",
    "**/docs/**",
    "apps/hoa/scripts/schema-doc/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "**/.wrangler/**",
    ".agents/**",
    ".claude/skills/**",
    "best-practices/**",
    "AGENTS.md",
    "CLAUDE.md",
    ".github/copilot-instructions.md",
    ".fixtures/**",
    ".vscode/mcp.json",
    "pnpm-lock.yaml"
  ]
}
