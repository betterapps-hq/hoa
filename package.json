{
  "private": true,
  "name": "hoa-workspace",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "verify": "run-s check:format check:lint check:types check:unused test:coverage",
    "check": "run-p check:format check:lint check:types check:unused",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
