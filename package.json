{
  "private": true,
  "name": "hoa-workspace",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "verify": "run-s check:format check:lint check:types check:unused test:coverage",
    "check": "run-p check:format check:lint check:types check:unused",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "prepare": "lefthook install",
    "guidance:sync": "playbook-sync",
    "guidance:check": "playbook-sync --check",
    "guidance:update": "pnpm update @betterapps/playbook --latest && playbook-sync",
    "skills:add": "skills add",
    "skills:update": "skills update -p",
    "skills:remove": "skills remove",
    "skills:check": "skills check"
  },
  "devDependencies": {
    "@betterapps/playbook": "github:betterapps-hq/playbook",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rulesync": "43.5.0",
    "skills": "1.7.6",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.10.1"
}
