# Copy to .env and fill in. .env is git-ignored.

# OpenRouter API key for the hoa workspace: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=

# Langfuse hoa project API keys: Langfuse > Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to the US cloud region.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Prompt label fetched from Langfuse prompt management: development locally; previews use preview, the demo production.
LANGFUSE_PROMPT_LABEL=development
# Langfuse environment for this machine's traces. Defaults to development.
LANGFUSE_TRACING_ENVIRONMENT=development

# Azure Document Intelligence, for OCR when documents are uploaded:
# Azure portal > the Document Intelligence resource > Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Accounts (docs/design/people.md). The secret signs sessions; local development uses a fixed one when it's empty.
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app is served, for links in emails and Google's redirect. Taken from the request when empty.
BETTER_AUTH_URL=
# Google sign-in: Google Cloud console > APIs & Services > Credentials > OAuth client. Off unless both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend, for sign-in codes and invitations. Empty, local development prints each email to the dev server's log.
RESEND_API_KEY=
EMAIL_FROM=
# Better Auth Infrastructure's dashboard of users and sign-ins: dash.better-auth.com > your project. Off when empty.
BETTER_AUTH_API_KEY=
# Cloudflare Turnstile's bot check on signing in and sending codes: Cloudflare > Turnstile > the widget. Off unless both
# are set. Cloudflare's test keys pass every check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
