{
  "name": "hoa",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "storybook": "storybook dev --port 6006 --no-open",
    "deploy:demo": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hoa-dev --local --env dev",
    "db:seed:local": "wrangler d1 execute hoa-dev --local --env dev --file seed/hoa.sql && wrangler d1 execute hoa-dev --local --env dev --file seed/people.sql",
    "db:reset:rules": "tsx scripts/reset-rules.ts",
    "db:seed:rulebook": "tsx scripts/seed-sample-rulebook.ts",
    "db:migrate:preview": "wrangler d1 migrations apply hoa-preview --remote --env preview-workflows",
    "db:seed:preview": "wrangler d1 execute hoa-preview --remote --env preview-workflows --file seed/hoa.sql",
    "db:migrate:demo": "wrangler d1 migrations apply hoa --remote",
    "db:seed:demo": "wrangler d1 execute hoa --remote --file seed/hoa.sql",
    "check:types": "tsc --noEmit",
    "ocr:fixture": "tsx --env-file=.env scripts/ocr-fixture.ts",
    "structure:compare": "tsx scripts/compare-structure.ts",
    "eval:encoding": "tsx --env-file=.env scripts/eval-encoding.ts",
    "eval:encoding:score": "tsx --env-file=.env scripts/eval-encoding-score.ts",
    "eval:datasets": "tsx scripts/eval-datasets.ts",
    "eval:step": "tsx --env-file=.env scripts/eval-step.ts",
    "eval:suggestions": "tsx --env-file=.env scripts/eval-suggestions.ts",
    "eval:review": "tsx --env-file=.env scripts/eval-review.ts",
    "golden:skeleton": "tsx scripts/golden-skeleton.ts",
    "review:corrections": "tsx --env-file=.env scripts/export-corrections.ts",
    "docs:schema": "node scripts/build-schema-doc.ts",
    "erd": "pnpm erd:build && vite preview erd/dist/site --outDir . --open",
    "erd:build": "node erd/build.ts && pnpm dlx @liam-hq/cli@0.7.24 erd build --input erd/dist/tbls.json --format tbls --output-dir erd/dist/site",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "auth:langfuse": "node --env-file=.env -e \"const { LANGFUSE_PUBLIC_KEY: publicKey, LANGFUSE_SECRET_KEY: secretKey } = process.env; if (!publicKey || !secretKey) throw new Error('LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are required'); console.log(Buffer.from(`${publicKey}:${secretKey}`).toString('base64'))\""
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/infra": "^0.4.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@langfuse/client": "6.1.0",
    "@langfuse/otel": "5.13.0",
    "@langfuse/tracing": "5.13.0",
    "@mantine/hooks": "^9.7.4",
    "@marsidev/react-turnstile": "^1.6.3",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@shadcn/react": "0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@uploadcn/core": "^0.1.3",
    "@uploadcn/react": "^0.1.3",
    "ai": "7.0.154",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.14",
    "bowser": "^2.15.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.2",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tiny-invariant": "^1.3.3",
    "ts-extras": "^1.3.0",
    "ts-pattern": "^5.9.2",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.153.0"
  }
}
