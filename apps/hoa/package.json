{
  "name": "hoa",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "deploy:demo": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hoa-dev --local --env dev",
    "db:seed:local": "wrangler d1 execute hoa-dev --local --env dev --file seed/hoa.sql",
    "db:migrate:preview": "wrangler d1 migrations apply hoa-preview --remote --env preview-workflows",
    "db:seed:preview": "wrangler d1 execute hoa-preview --remote --env preview-workflows --file seed/hoa.sql",
    "db:migrate:demo": "wrangler d1 migrations apply hoa --remote",
    "db:seed:demo": "wrangler d1 execute hoa --remote --file seed/hoa.sql",
    "verify": "run-s check test:coverage",
    "check": "run-p check:*",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --max-warnings=0",
    "check:types": "tsc --noEmit",
    "check:unused": "knip --directory ../.. --workspace apps/hoa",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "auth:langfuse": "node --env-file=.env -e \"const { LANGFUSE_PUBLIC_KEY: publicKey, LANGFUSE_SECRET_KEY: secretKey } = process.env; if (!publicKey || !secretKey) throw new Error('LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are required'); console.log(Buffer.from(`${publicKey}:${secretKey}`).toString('base64'))\""
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@langfuse/client": "5.13.0",
    "@langfuse/otel": "5.13.0",
    "@langfuse/tracing": "5.13.0",
    "@mantine/hooks": "^9.7.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "ai": "7.0.128",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.2",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.72.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "wrangler": "4.148.0"
  }
}
